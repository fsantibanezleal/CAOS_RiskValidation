{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fsantibanezleal/CAOS_RiskValidation/policies/policy.schema.json",
  "title": "A riskvalidation policy file",
  "description": "The format of policies/*.json (docs/policies.md). format_version 1: thresholds keyed by test id; an entry is two cut points, optionally with named parameters, a rule of riskvalidation.policies.rules, and a key field with one case per value.",
  "type": "object",
  "required": ["policy_id", "version", "thresholds"],
  "additionalProperties": false,
  "properties": {
    "format_version": {"const": 1, "description": "The version of this format; absent means 1."},
    "policy_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "descriptive_without_thresholds": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Test ids that report a descriptive metric and state no threshold (informational; default.json)."
    },
    "thresholds": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z][a-z0-9_]*(\\.[A-Za-z0-9_]+)+$"},
      "additionalProperties": {"$ref": "#/$defs/entry"}
    }
  },
  "$defs": {
    "numbers": {"type": "object", "additionalProperties": {"type": "number"}},
    "entry": {
      "type": "object",
      "required": ["kind", "amber", "red"],
      "additionalProperties": false,
      "dependentRequired": {"by": ["cases"], "cases": ["by"]},
      "properties": {
        "kind": {"enum": ["p_value", "upper_bad", "lower_bad"]},
        "amber": {"type": "number"},
        "red": {"type": "number"},
        "source": {"type": "string", "description": "A battery entry starts 'convention: ' or 'regulatory: ' (docs/policies.md)."},
        "parameters": {"$ref": "#/$defs/numbers"},
        "rule": {"type": "string", "pattern": "^[a-z][a-z0-9_]*(:[A-Za-z_][A-Za-z0-9_.]*)?$"},
        "by": {"type": "string", "pattern": "^(segment|extras\\.[A-Za-z_][A-Za-z0-9_.]*)$"},
        "cases": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/numbers"}}
      }
    }
  }
}
